{
  "providers": {
    "anthropic":    { "api_key": "${ANTHROPIC_API_KEY}" },
    "azure_openai": { "api_key": "${AZURE_OPENAI_API_KEY}", "endpoint": "${AZURE_OPENAI_ENDPOINT}", "api_version": "2024-02-01" },
    "ollama":       { "base_url": "http://localhost:11434" },
    "openrouter":   { "api_key": "${OPENROUTER_API_KEY}" }
  },
  "agents": {
    "orchestrator":       { "provider": "azure_openai", "model": "gpt-4o" },
    "question_generator": { "provider": "azure_openai", "model": "gpt-4o" },
    "evaluator":          { "provider": "azure_openai", "model": "gpt-4o-mini" },
    "analyzer":           { "provider": "azure_openai", "model": "gpt-4o-mini" },
    "advisor":            { "provider": "azure_openai", "model": "gpt-4o-mini" }
  }
}
